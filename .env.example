# Generate with: .\outputs\sharepipe-windows-amd64.exe hash-password
SHAREPIPE_ADMIN_PASSWORD_HASH=

# Optional. If omitted, SharePipe creates data/session.key on first start.
SHAREPIPE_SESSION_SECRET=

# Exactly 32 random bytes encoded as base64/base64url. If omitted in local mode,
# SharePipe creates data/storage.key. Public launchers should inject this secret.
SHAREPIPE_STORAGE_MASTER_KEY=

# Optional S3-compatible storage credentials. Never commit real values.
SHAREPIPE_S3_ACCESS_KEY_ID=
SHAREPIPE_S3_SECRET_ACCESS_KEY=
SHAREPIPE_S3_SESSION_TOKEN=

# Cloudflare Access public administrator mode.
SHAREPIPE_CF_ACCESS_TEAM_DOMAIN=
SHAREPIPE_CF_ACCESS_AUDIENCE=
SHAREPIPE_ADMIN_EMAILS=admin@example.com

# Optional overrides.
SHAREPIPE_LISTEN=127.0.0.1:8080
SHAREPIPE_PUBLIC_BASE_URL=http://127.0.0.1:8080
SHAREPIPE_LOCAL_STORAGE_ROOT=data/storage
